{
  "permissions": {
    "allow": [
      "Bash(awk -F',' '$1==\"postgres\" && $2==\"no_index\"')",
      "Bash(rtk make *)",
      "Bash(rtk read *)",
      "Bash(experiments/.venv/bin/python experiments/run.py delay)",
      "Bash(experiments/.venv/bin/python experiments/parse.py delay)",
      "Bash(rtk grep *)",
      "Bash(rtk wc *)",
      "Bash(rtk ls *)",
      "Bash(rtk proxy *)",
      "Bash(/bin/echo test123 *)",
      "Bash(rtk find *)"
    ],
    "deny": [
      "Read(~/Documents/pessoal/obsidian/pixels/Journal/Daily Notes/**)",
      "Edit(~/Documents/pessoal/obsidian/pixels/Journal/Daily Notes/**)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kim/.claude/notify-hook.sh 'Claude needs your input'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kim/.claude/notify-hook.sh 'Claude finished'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /Users/kim/.claude/hooks/protect-daily-notes.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/kim/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-retrospective@bitwarden-marketplace": true,
    "superpowers@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "bitwarden-marketplace": {
      "source": {
        "source": "github",
        "repo": "bitwarden/ai-plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "dark",
  "agentPushNotifEnabled": true
}
