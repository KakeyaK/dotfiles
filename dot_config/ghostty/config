macos-titlebar-style = hidden
theme = Dracula
window-padding-x = 10
window-padding-y = 10
# background-blur = macos-glass-clear
background-opacity=0.8
background-blur=40

desktop-notifications = true

macos-option-as-alt = left 
confirm-close-surface = false
quit-after-last-window-closed = true

keybind = cmd+shift+n=new_window

# --- Zellij Passthrough Bindings ---
keybind = cmd+t=unbind
keybind = cmd+n=unbind
keybind = cmd+h=unbind
keybind = cmd+j=unbind
keybind = cmd+k=unbind
keybind = cmd+l=unbind
keybind = cmd+x=unbind
keybind = cmd+shift+x=unbind
